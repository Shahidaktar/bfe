generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  bucketLists   BucketList[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model PlanMyJourneySubmission {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  fullName        String
  phone           String?
  email           String
  destination     String
  citiesToCover   String?
  departureCity   String?
  arrivalCity     String?
  departureDate   String?
  returnDate      String?
  travellers      String?
  hotelBreakfast  String?
  sightseeing     String?
  visa            String?
  transport       String?
  roomView        String?
  bedding         String?
  experiences     String[]
  otherServices   String[]
  travelInsurance String?
  saveDetails     Boolean  @default(true)

  @@map("plan_my_journey_submissions")
}

model AssessmentQuestion {
  id        String   @id @default(cuid())
  order     Int      @default(0)
  type      String   // text | radio | checkbox
  title     String
  required  Boolean  @default(false)
  options   Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@map("assessment_questions")
}

model AssessmentSubmission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  firstName String
  lastName  String
  phone     String
  email     String
  answers   Json     // [{ questionId, title, type, answer }]

  @@map("assessment_submissions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String    @db.Text
  content     String    @db.Text
  coverImage  String?
  category    String    @default("Journal")
  author      String    @default("Beyond Forever Earth")
  status      String    @default("draft")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([createdAt])
  @@map("blog_posts")
}

model BucketList {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String
  category      String
  destinationId String
  destination   String
  location      String
  description   String   @db.Text
  days          Int      @default(10)
  price         Int
  startDate     String
  endDate       String
  message       String?  @db.Text
  status        String   @default("new")

  @@index([userId])
  @@index([createdAt])
  @@map("bucket_lists")
}
