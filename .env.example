# Postgres connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL=

# Secret used to sign auth tokens. The value in .env was generated automatically;
# if you recreate this file, generate a new one with: npx auth secret
AUTH_SECRET=

# Google OAuth credentials from Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID, type: Web application).
# Authorized redirect URI to add in Google Console:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Admin panel credentials (email/password). Used for /admin.
# Change these before deploying.
ADMIN_EMAIL=
ADMIN_PASSWORD=
